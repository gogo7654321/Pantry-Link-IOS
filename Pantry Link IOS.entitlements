<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications. Xcode/automatic signing maps this to development or production APNs
	     at build time. Requires the "Push Notifications" capability enabled on the App ID. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Lets urgent coordination alerts (new need, claim accepted/rejected, drop-off, deadline)
	     break through Focus / Do Not Disturb via interruptionLevel = .timeSensitive.
	     Requires the "Time Sensitive Notifications" capability on the App ID. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
