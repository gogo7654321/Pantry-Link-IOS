<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications. Xcode/automatic signing maps this to development or production APNs
	     at build time. Requires the "Push Notifications" capability enabled on the App ID. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
